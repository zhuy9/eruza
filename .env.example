# Local settings only. Do not add tokens or passwords.
# Set MOCK=1 to run without Azure CLI or organization settings.
MOCK=1

# Organization name, not a URL. Required only when MOCK=0.
ADO_ORG=

# Optional initial project. Other projects can be selected in the app.
ADO_DEFAULT_PROJECT=

# Local API port. Vite uses its own loopback port and proxies /api.
PORT=3001

# Optional name and local logo for the sidebar and browser tab. Restart after edits.
# Display-only values: VITE_ settings are included in the browser build, never secrets.
# A logo at public/branding/logo.svg uses /branding/logo.svg here.
VITE_BRAND_NAME=
VITE_BRAND_LOGO=
