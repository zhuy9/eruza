# Local settings only. Do not add tokens or passwords.
# Set MOCK=1 to run without Azure CLI or organization settings.
MOCK=1

# Organization name, not a URL. Required only when MOCK=0.
ADO_ORG=

# Optional initial project. Other projects can be selected in the app.
ADO_DEFAULT_PROJECT=

# Local API port. Vite uses its own loopback port and proxies /api.
PORT=3001
